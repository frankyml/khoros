#!/usr/bin/env python3
"""
Khoros v4 - Claude Code hook entrypoint (stdlib only).

  khoros-gate session-start  SessionStart hook: snapshot the working tree so Stop knows what THIS session changed.
  khoros-gate stop           Stop hook: verify what the session changed before Claude may finish.
  khoros-gate post-edit      PostToolUse hook: fast static checks on the edited file + edit-loop detection.

Stop blocks with `{"decision": "block", "reason": ...}` on stdout and exit 0. Any internal error, and any state
that cannot be persisted, allows the stop: the gate must never hang, crash or loop a session.
State lives in the git dir (`<git-dir>/khoros/`), never in the work tree.
"""

import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT_HARNESS_DIR = Path(__file__).resolve().parent.parent / ".harness"
sys.path.insert(0, str(ROOT_HARNESS_DIR))

NON_CODE_SUFFIXES = (".md", ".markdown", ".txt", ".rst")
TEST_RULES = ("UNIT_TEST_FAILURE", "TEST_TIMEOUT")
REASON_MAX_LINES = 60
STALE_STATE_SECONDS = 14 * 24 * 3600
RUNS_KEPT = 50


def read_payload() -> dict:
    try:
        raw = sys.stdin.read()
        data = json.loads(raw) if raw.strip() else {}
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def emit(obj: dict) -> None:
    print(json.dumps(obj))


# --------------------------------------------------------------------------- git / state

def git(cwd, *args, env=None, timeout=60):
    """stdout of a git command, or None when it fails."""
    try:
        proc = subprocess.run(
            ["git", *args], cwd=str(cwd), capture_output=True, text=True, errors="replace", timeout=timeout, env=env
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return proc.stdout if proc.returncode == 0 else None


def repo_root(cwd: Path):
    """The work tree root, whatever subdirectory the hook was started in; None outside a git repo."""
    out = git(cwd, "rev-parse", "--show-toplevel", timeout=20)
    return Path(out.strip()) if out and out.strip() else None


def state_dir(root: Path):
    """`<git-dir>/khoros`, else a temp dir keyed by the repo path; None when neither can be created."""
    candidates = []
    git_dir = git(root, "rev-parse", "--absolute-git-dir", timeout=20)
    if git_dir and git_dir.strip():
        candidates.append(Path(git_dir.strip()) / "khoros")
    key = hashlib.sha1(str(root).encode()).hexdigest()[:12]
    candidates.append(Path(tempfile.gettempdir()) / f"khoros-gate-{key}")
    for candidate in candidates:
        try:
            candidate.mkdir(parents=True, exist_ok=True)
        except OSError:
            continue
        return candidate
    return None


def state_path(sd: Path, kind: str, session: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", session or "default")[:80]
    return sd / f"{kind}-{safe}.json"


def load_state(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def save_state(path: Path, data: dict) -> bool:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data), encoding="utf-8")
        return True
    except OSError:
        return False


def drop_state(path: Path) -> None:
    try:
        path.unlink()
    except OSError:
        pass


def prune_stale_state(sd: Path) -> None:
    cutoff = time.time() - STALE_STATE_SECONDS
    try:
        for f in sd.glob("*.json"):
            if f.stat().st_mtime < cutoff:
                f.unlink()
    except OSError:
        pass


def is_khoros_repo(root: Path) -> bool:
    """The gate acts only where Khoros is set up, so loading the plugin for every session is safe."""
    return (root / ".harness" / "config.yaml").is_file()


def gate_disabled(cfg: dict, sd=None, session: str = "") -> bool:
    """Off by env, by config, or for one session by `off-<session>.json` holding {"off": true} (the khoros-view mod)."""
    if os.environ.get("KHOROS_GATE", "").strip().lower() == "off" or cfg.get("gate") == "off":
        return True
    return sd is not None and load_state(state_path(sd, "off", session)).get("off") is True


def record_run(sd: Path, session: str, outcome: str, **fields) -> None:
    """Append one Stop outcome to `runs-<session>.json` for viewers (the khoros-view mod); never fails the gate."""
    path = state_path(sd, "runs", session)
    runs = load_state(path).get("runs") or []
    runs.append({"at": time.time(), "outcome": outcome, **fields})
    save_state(path, {"runs": runs[-RUNS_KEPT:]})


def run_summary(report: dict, new: dict, pre: dict, files: list, started: float) -> dict:
    """What a viewer needs from one verification: the checks, the tests and which failures were new."""
    tests = report.get("tests") or {}
    return {
        "files": len(files),
        "seconds": round(time.monotonic() - started, 1),
        "violations": [
            {k: v.get(k) for k in ("rule", "file", "line", "message")} for v in report.get("violations", [])
        ][:10],
        "tests": [{"command": r.get("command"), "status": r.get("status")} for r in tests.get("runs") or []],
        "new": sorted(new),
        "preexisting": sorted(pre),
    }


def is_code_path(path: str) -> bool:
    return bool(path) and not path.startswith((".harness/", "docs/")) and not path.lower().endswith(NON_CODE_SUFFIXES)


def snapshot_tree(root: Path, commit: bool = False):
    """Tree (and optionally a commit) of the whole work tree incl. untracked files, without touching the
    real index or any ref: `git add -A` into a copy of the index. -> {"tree", "commit"} or None."""
    index_path = git(root, "rev-parse", "--git-path", "index", timeout=20)
    if not index_path or not index_path.strip():
        return None
    src = Path(index_path.strip())
    if not src.is_absolute():
        src = root / src
    with tempfile.TemporaryDirectory(prefix="khoros-index-") as td:
        idx = Path(td) / "index"
        if src.is_file():
            try:
                shutil.copy2(src, idx)  # keep the mtime: git's racy-entry check compares it with the entries'
            except OSError:
                return None
        env = dict(os.environ, GIT_INDEX_FILE=str(idx), GIT_AUTHOR_NAME="khoros", GIT_AUTHOR_EMAIL="khoros@localhost",
                   GIT_COMMITTER_NAME="khoros", GIT_COMMITTER_EMAIL="khoros@localhost")
        if git(root, "add", "-A", env=env) is None:
            return None
        tree = (git(root, "write-tree", env=env) or "").strip()
        if not tree:
            return None
        result = {"tree": tree, "commit": ""}
        if commit:
            head = (git(root, "rev-parse", "--verify", "-q", "HEAD", timeout=20) or "").strip()
            args = ["commit-tree", tree, "-m", "khoros session baseline"] + (["-p", head] if head else [])
            result["commit"] = (git(root, *args, env=env) or "").strip()
        return result


def session_changed_files(root: Path, sess: dict, edits: dict):
    """Code files THIS session changed (relative paths; deleted ones included).

    With a SessionStart baseline: the diff between the baseline tree and the work tree now. That covers edits,
    commits and dirty files that changed, and ignores files that were already dirty or red before the session.
    Without one: only the files the post-edit hook recorded.
    """
    base_tree = sess.get("tree")
    if base_tree:
        now = snapshot_tree(root)
        out = git(root, "diff-tree", "-r", "--name-only", "--no-renames", "-z", base_tree, now["tree"]) if now else None
        if out is not None:
            return [p for p in out.split("\0") if is_code_path(p)]
    files = []
    for raw in (edits.get("counts") or {}):
        try:
            rel = Path(raw).relative_to(root).as_posix()
        except ValueError:
            continue
        if is_code_path(rel):
            files.append(rel)
    return sorted(files)


# --------------------------------------------------------------------------- baseline

def baseline_runs(root: Path, cfg: dict, sess: dict, sd: Path, deadline: float):
    """Test results of the session's starting tree, run once per (baseline commit, test command) in a
    temporary detached worktree and cached in the state dir. None when unavailable."""
    from verifier import VerificationPipeline, detect_test_commands

    commit = sess.get("commit")
    if not commit:
        return None
    labels = [r["label"] for r in detect_test_commands(root, cfg)[0]]
    key = hashlib.sha1("\0".join([commit, *labels]).encode()).hexdigest()[:16]
    cache = sd / f"baseline-{key}.json"
    cached = load_state(cache).get("runs")
    if isinstance(cached, list):
        return cached
    if deadline - time.monotonic() < 5:
        return None

    wt = Path(tempfile.mkdtemp(prefix="khoros-baseline-"))
    try:
        git(root, "worktree", "prune", timeout=20)
        if git(root, "worktree", "add", "--detach", str(wt), commit) is None:
            return None
        for name in ("node_modules", ".venv", "venv"):  # ignored dependency dirs are not in a fresh checkout
            if (root / name).exists() and not (wt / name).exists():
                try:
                    os.symlink(root / name, wt / name)
                except OSError:
                    pass
        pipeline = VerificationPipeline(workspace_dir=wt, deadline=deadline, python_root=root)
        pipeline.config = cfg
        result = pipeline.run_tests(cfg["test_timeout"])
        runs = [
            {"command": r["command"], "status": r["status"], "failing_ids": r.get("failing_ids")}
            for r in result.get("runs", [])
        ]
        if not any(r["status"] == "timeout" for r in runs):  # a timeout says nothing durable
            save_state(cache, {"runs": runs})
        return runs
    finally:
        git(root, "worktree", "remove", "--force", str(wt), timeout=30)
        shutil.rmtree(wt, ignore_errors=True)
        git(root, "worktree", "prune", timeout=20)


def classify_failures(failed_runs: list, baseline):
    """-> (new, preexisting): failures that are new versus the baseline, and those that already failed.

    Ids parsed on both sides: the set difference. Otherwise block only if the baseline passed.
    """
    new, pre = {}, {}
    by_label = {r["command"]: r for r in baseline or []}
    for run in failed_runs:
        label, ids = run["command"], run.get("failing_ids")
        base = by_label.get(label) if baseline is not None else None
        if base is not None and base["status"] in ("failed", "timeout"):
            base_ids = base.get("failing_ids")
            if ids and base_ids is not None:
                fresh = [i for i in ids if i not in base_ids]
                if fresh:
                    new[label] = fresh
                if len(fresh) < len(ids):
                    pre[label] = [i for i in ids if i in base_ids]
            else:
                pre[label] = ids or [label]
        else:
            new[label] = ids or [label]
    return new, pre


# --------------------------------------------------------------------------- stop

def clamp_lines(text: str, limit: int = REASON_MAX_LINES) -> str:
    lines = text.splitlines()
    if len(lines) <= limit:
        return text
    head, tail = limit // 3, limit - limit // 3 - 1
    return "\n".join([*lines[:head], f"  ... ({len(lines) - head - tail} lines omitted)", *lines[-tail:]])


def short_list(items, limit: int = 6) -> str:
    items = list(items)
    return ", ".join(items[:limit]) + (f" (+{len(items) - limit} more)" if len(items) > limit else "")


def failure_signature(static_errs: list, new: dict) -> str:
    parts = sorted(f"{v.get('rule')}|{v.get('file')}|{v.get('message')}" for v in static_errs)
    parts += sorted(f"{label}|{i}" for label, ids in new.items() for i in ids)
    return hashlib.sha1("\n".join(parts).encode()).hexdigest()[:16]


def allow(*notes: str) -> int:
    notes = [n for n in notes if n]
    if notes:
        emit({"systemMessage": "\n".join(notes)})
    return 0


def cmd_stop(payload: dict) -> int:
    from verifier import VerificationPipeline, format_report, load_verify_config

    started = time.monotonic()
    if payload.get("agent_id"):  # a subagent's own stop: the parent's Stop covers its work
        return 0
    cwd = Path(payload.get("cwd") or os.getcwd())
    root = repo_root(cwd)
    if root is None or not is_khoros_repo(root):
        return 0
    cfg = load_verify_config(root)
    if gate_disabled(cfg):
        return 0
    sd = state_dir(root)
    if sd is None:
        return 0

    session = str(payload.get("session_id") or "default")
    if gate_disabled(cfg, sd, session):
        return 0
    files = session_changed_files(root, load_state(state_path(sd, "session", session)),
                                  load_state(state_path(sd, "edits", session)))
    if not files:
        return 0
    if not os.access(sd, os.W_OK):
        return allow(f"khoros gate: cannot write its state in {sd}; allowing stop without verifying.")

    sess = load_state(state_path(sd, "session", session))
    gpath = state_path(sd, "gate", session)
    gstate = load_state(gpath)
    max_blocks = int(cfg["max_stop_blocks"])
    deadline = started + float(cfg["gate_budget"])

    # stall: nothing changed since the last block, so blocking again would only burn a turn on the same result
    now = snapshot_tree(root)
    tree_now = now["tree"] if now else ""
    if tree_now and gstate.get("tree") == tree_now and not gstate.get("gave_up"):
        save_state(gpath, {**gstate, "gave_up": True})
        record_run(sd, session, "stall", attempt=int(gstate.get("blocks", 0)), max=max_blocks, files=len(files))
        return allow("khoros gate: no changes since the last failed verification; releasing the stop. "
                     "Tell the user verification is still failing and why.")

    existing = [root / f for f in files if (root / f).is_file()]
    # an explicit target list that is empty would mean "everything", so point it at nothing instead
    _, report = VerificationPipeline(workspace_dir=root, deadline=deadline).run(
        targets=existing or [root / ".khoros-no-files"], run_tests=True, test_timeout=cfg["test_timeout"],
        scope_label="session",
    )

    tests = report.get("tests") or {}
    static_errs = [
        v for v in report["violations"] if v.get("severity", "ERROR") == "ERROR" and v.get("rule") not in TEST_RULES
    ]
    failed_runs = [r for r in tests.get("runs") or [] if r["status"] == "failed"]
    notes = []
    new, pre = {}, {}
    if failed_runs:
        baseline = baseline_runs(root, cfg, sess, sd, deadline)
        if baseline is None and deadline - time.monotonic() <= 0:
            # out of time to compare: do not block on what we cannot attribute
            notes.append("khoros gate: tests failed but the time budget ran out before the baseline run; allowing stop.")
        else:
            new, pre = classify_failures(failed_runs, baseline)

    # render only what blocks: pre-existing failures are a note, not a violation
    for r in failed_runs:
        if r["command"] not in new:
            r["status"] = "preexisting"
    report["violations"] = [
        v for v in report["violations"]
        if not (v.get("rule") == "UNIT_TEST_FAILURE" and v.get("file") not in new)
    ]
    report["violation_count"] = len(report["violations"])
    blocking = bool(static_errs or new)

    if pre:
        names = [f"{label}: {i}" if i != label else label for label, ids in pre.items() for i in ids]
        notes.append(f"khoros gate: {len(names)} test failure(s) pre-date this session and were not caused by it: "
                     f"{short_list(names)}.")
    if report.get("timed_out"):
        notes.append(f"khoros gate: tests exceeded their time budget (verify.test_timeout {cfg['test_timeout']}s, "
                     f"gate budget {cfg['gate_budget']}s). Tell the user verification timed out.")

    summary = run_summary(report, new, pre, files, started)
    if report.get("timed_out"):
        summary["timed_out"] = True

    if not blocking:
        drop_state(gpath)
        record_run(sd, session, "pass", **summary)
        return allow(*notes)

    sig = failure_signature(static_errs, new)
    if gstate.get("gave_up") and gstate.get("signature") == sig:
        record_run(sd, session, "given_up", **summary)
        return 0  # already gave up on exactly this failure: stay given up
    blocks = 0 if gstate.get("signature") != sig and gstate.get("gave_up") else int(gstate.get("blocks", 0))

    if blocks >= max_blocks:
        save_state(gpath, {"blocks": blocks, "gave_up": True, "signature": sig, "tree": tree_now})
        record_run(sd, session, "gave_up", attempt=blocks, max=max_blocks, **summary)
        return allow(
            f"khoros gate gave up after {max_blocks} attempts; tell the user verification is failing.",
            clamp_lines(format_report(report, tail_lines=20), 25),
            *notes,
        )

    if not save_state(gpath, {"blocks": blocks + 1, "gave_up": False, "signature": sig, "tree": tree_now}):
        # the counter cannot advance, so blocking could repeat forever: fail open
        return allow("khoros gate: cannot persist its retry counter; allowing stop without blocking.", *notes)
    record_run(sd, session, "block", attempt=blocks + 1, max=max_blocks, **summary)

    head = (
        f"khoros gate: verification failed (attempt {blocks + 1}/{max_blocks}). "
        "Fix the root cause, do not skip, weaken or bypass checks."
    )
    extra = []
    if new:
        names = [f"{label}: {i}" if i != label else label for label, ids in new.items() for i in ids]
        extra.append(f"New failures since this session started: {short_list(names)}")
    if pre:
        extra.append("Failures that pre-date this session (ignored, not yours): " + short_list(
            f"{label}: {i}" if i != label else label for label, ids in pre.items() for i in ids))
    reason = clamp_lines("\n".join([head, *extra, format_report(report, tail_lines=30)]))
    emit({"decision": "block", "reason": reason})
    return 0


# --------------------------------------------------------------------------- session-start / post-edit

def cmd_session_start(payload: dict) -> int:
    from verifier import load_verify_config

    cwd = Path(payload.get("cwd") or os.getcwd())
    root = repo_root(cwd)
    if root is None or not is_khoros_repo(root) or gate_disabled(load_verify_config(root)):
        return 0
    sd = state_dir(root)
    if sd is None:
        return 0
    session = str(payload.get("session_id") or "default")
    spath = state_path(sd, "session", session)
    if payload.get("source") == "compact" and load_state(spath).get("tree"):
        return 0  # same session continues: keep its original baseline
    snap = snapshot_tree(root, commit=True)
    if snap is None:
        return 0
    head = (git(root, "rev-parse", "--verify", "-q", "HEAD", timeout=20) or "").strip()
    if save_state(spath, {"head": head, "tree": snap["tree"], "commit": snap["commit"] or head,
                          "started": time.time()}):
        drop_state(state_path(sd, "gate", session))
        prune_stale_state(sd)
    return 0


def cmd_post_edit(payload: dict) -> int:
    from verifier import VerificationPipeline, format_report, load_verify_config

    cwd = Path(payload.get("cwd") or os.getcwd())
    root = repo_root(cwd) or cwd
    if not is_khoros_repo(root):
        return 0
    cfg = load_verify_config(root)
    if gate_disabled(cfg):
        return 0
    tool_input = payload.get("tool_input") or {}
    raw = tool_input.get("file_path") or tool_input.get("notebook_path")
    if not raw:
        return 0
    fpath = Path(raw)
    if not fpath.is_absolute():
        fpath = cwd / fpath

    messages = []

    # record the edit (Stop falls back to these when there is no SessionStart baseline) and detect edit loops
    session = str(payload.get("session_id") or "default")
    sd = state_dir(root)
    if gate_disabled(cfg, sd, session):
        return 0
    if sd is not None:
        spath = state_path(sd, "edits", session)
        state = load_state(spath)
        counts = state.setdefault("counts", {})
        key = str(fpath)
        counts[key] = int(counts.get(key, 0)) + 1
        save_state(spath, state)
        threshold = int(cfg["loop_edit_threshold"])
        if threshold > 0 and counts[key] % threshold == 0:
            messages.append(
                f"khoros gate: {fpath.name} has been edited {counts[key]} times this session. "
                "Step back: re-read the failing output, and reconsider the approach instead of patching again."
            )

    if fpath.is_file() and ".harness" not in fpath.parts:
        _, report = VerificationPipeline(workspace_dir=root).run(targets=[fpath], fast=True)
        if not report["passed"]:
            messages.insert(0, format_report(report))

    if messages:
        print("\n".join(messages), file=sys.stderr)
        return 2
    return 0


def on_sigterm(signum, frame):
    """Claude Code cancelled the hook: take the test process groups down with us."""
    try:
        from verifier import terminate_requested

        terminate_requested()
    except ImportError:
        raise SystemExit(0)


def main(argv) -> int:
    try:
        payload = read_payload()
        signal.signal(signal.SIGTERM, on_sigterm)
        command = argv[1] if len(argv) > 1 else ""
        if command == "stop":
            return cmd_stop(payload)
        if command == "session-start":
            return cmd_session_start(payload)
        if command == "post-edit":
            return cmd_post_edit(payload)
        print("usage: khoros-gate session-start|stop|post-edit", file=sys.stderr)
        return 0
    except Exception as e:  # never break a session because of the gate itself
        try:
            print(f"khoros gate: internal error ignored ({type(e).__name__}: {e})", file=sys.stderr)
        except Exception:
            pass
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
