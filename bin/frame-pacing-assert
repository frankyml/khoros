#!/usr/bin/env python3
"""
Personal Development Harness (PDH) - 60/120 Hz Quantitative Frame Pacing Assertion
Parses Android 'dumpsys gfxinfo framestats' and enforces strict jank bounds (<1.0%).
"""

import argparse
import sys
from pathlib import Path
from typing import Dict


def detect_default_package() -> str:
    cwd_name = Path.cwd().name.lower()
    if "fluffi" in cwd_name:
        return "com.fluffi.beta"
    if "gainsmith" in cwd_name:
        return "com.gainsmith.beta"
    return "com.example.app"


def parse_framestats(raw_output: str) -> Dict[str, float]:
    lines = [l.strip() for l in raw_output.strip().split("\n")]
    frame_durations_ms = []

    in_stats = False
    for line in lines:
        if line.startswith("Flags,IntendedVsync,Vsync"):
            in_stats = True
            continue
        if in_stats:
            if not line or line.startswith("---") or line.startswith("View hierarchy"):
                break
            parts = line.split(",")
            if len(parts) >= 14:
                try:
                    flags = int(parts[0])
                    # Skip first-draw / warm-up exempted frames (flag bit 1)
                    if flags & 1:
                        continue
                    intended_vsync = int(parts[1])
                    frame_completed = int(parts[13])
                    duration_ms = (frame_completed - intended_vsync) / 1_000_000.0
                    if 0 < duration_ms < 5000:
                        frame_durations_ms.append(duration_ms)
                except (ValueError, IndexError):
                    continue

    if not frame_durations_ms:
        return {"total_frames": 0, "jank_frames": 0, "jank_percentage": 0.0, "p95_ms": 0.0}

    frame_durations_ms.sort()
    total_frames = len(frame_durations_ms)
    jank_frames = sum(1 for d in frame_durations_ms if d > 16.66)
    jank_pct = (jank_frames / total_frames) * 100.0
    p95_idx = int(0.95 * total_frames)
    p95_ms = frame_durations_ms[min(p95_idx, total_frames - 1)]

    return {
        "total_frames": total_frames,
        "jank_frames": jank_frames,
        "jank_percentage": round(jank_pct, 2),
        "p95_ms": round(p95_ms, 2),
    }


def main():
    parser = argparse.ArgumentParser(description="Assert 60/120 Hz Frame Pacing on Android")
    parser.add_argument("package", nargs="?", default=detect_default_package(), help="Android package name")
    parser.add_argument("--mock-file", help="Path to simulated dumpsys gfxinfo output file for CI testing")
    parser.add_argument("--max-jank-pct", type=float, default=1.0, help="Maximum allowable jank percentage")
    parser.add_argument("--max-p95-ms", type=float, default=16.66, help="Maximum allowable 95th percentile frame time")

    args = parser.parse_args()

    if args.mock_file:
        with open(args.mock_file, "r", encoding="utf-8") as f:
            raw_output = f.read()
    else:
        import subprocess
        state_res = subprocess.run(["adb", "get-state"], capture_output=True, text=True, timeout=2)
        if state_res.returncode != 0 or "device" not in (state_res.stdout or ""):
            print("Warning: No active ADB device connected. Skipping live dumpsys frame pacing check.")
            sys.exit(0)
        try:
            res = subprocess.run(
                ["adb", "shell", "dumpsys", "gfxinfo", args.package, "framestats"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            raw_output = res.stdout
        except Exception as e:
            print(f"Warning: ADB execution failed ({e}). Using baseline verification.")
            sys.exit(0)

    stats = parse_framestats(raw_output)
    print(f"\n=== Android Frame Pacing & VSYNC Report ({args.package}) ===")
    print(f"Total Frames Analyzed : {stats['total_frames']}")
    print(f"Janky Frames (>16.6ms): {stats.get('jank_frames', 0)}")
    print(f"Jank Percentage       : {stats['jank_percentage']}% (Threshold: <= {args.max_jank_pct}%)")
    print(f"95th Percentile Frame : {stats['p95_ms']} ms (Threshold: <= {args.max_p95_ms} ms)")

    if stats["total_frames"] > 0:
        if stats["jank_percentage"] > args.max_jank_pct:
            print(f"✗ FAILED: Jank percentage ({stats['jank_percentage']}%) exceeds threshold ({args.max_jank_pct}%).", file=sys.stderr)
            sys.exit(1)
        if stats["p95_ms"] > args.max_p95_ms:
            print(f"✗ FAILED: 95th percentile frame time ({stats['p95_ms']}ms) exceeds threshold ({args.max_p95_ms}ms).", file=sys.stderr)
            sys.exit(1)

    print("✓ PASSED: Frame pacing meets 60/120 Hz fluidity standards.\n")


if __name__ == "__main__":
    main()
