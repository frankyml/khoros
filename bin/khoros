def format_table(headers, rows):
    widths = [len(h) for h in headers]
    for row in rows:
        for i, val in enumerate(row):
            widths[i] = max(widths[i], len(str(val)))

    header_str = " | ".join(h.ljust(widths[i]) for i, h in enumerate(headers))
    sep_str = "-+-".join("-" * widths[i] for i in range(len(headers)))
    out = [header_str, sep_str]
    for row in rows:
        out.append(" | ".join(str(val).ljust(widths[i]) for i, val in enumerate(row)))
    return "\n".join(out)


def default_lint_targets() -> List[Path]:
    candidates = [Path("shared/src"), Path("androidApp/src"), Path("src")]
    existing = [p for p in candidates if p.exists()]
    return existing if existing else [Path("src")]


def run_lint_targets(targets: List[Path]) -> int:
    linter = DesignTokenLinter()
    res = {}
    for target in targets:
        if target.is_file():
            viols = linter.lint_file(target)
            if viols:
                res[str(target)] = viols
        elif target.exists():
            res.update(linter.lint_directory(target))

    total_violations = sum(len(v) for v in res.values())
    if total_violations == 0:
        print("✓ All UI source files comply with design tokens.")
        return 0
    else:
        print(f"✗ Found {total_violations} design token violation(s):\n")
        for fpath, viols in res.items():
            print(f"File: {fpath}")
            for v in viols:
                print(f"  Line {v['line']} [{v['severity']}]: {v['rule']} - {v['message']}")
        return 1


def run_verification_gate(targets: List[Path] = None, profile: str = None, run_tests: bool = False) -> int:
    pipeline = VerificationPipeline(profile=profile)
    ok, report = pipeline.run(targets=targets, run_tests=run_tests)
    checks_str = ", ".join(report["checks_run"])
    if ok:
        print(f"✓ Universal Verification Gate passed [Profile: {report['profile']} | Checks: {checks_str}].")
        return 0
    else:
        print(
            f"✗ Verification Gate failed with {report['violation_count']} issue(s) "
            f"[Profile: {report['profile']} | Checks: {checks_str}]:\n"
        )
        for v in report["violations"]:
            print(f"  {v.get('file', '?')}:{v.get('line', 0)} [{v.get('severity', 'ERROR')}] {v.get('rule')}: {v.get('message')}")
        return 1


def _resolve_task_id(args) -> str:
    tid = getattr(args, "task_id", None) or getattr(args, "task_id_flag", None)
    if not tid:
        print("Error: Task ID is required.", file=sys.stderr)
        sys.exit(1)
    return tid


def cmd_status(args):
    bb = Blackboard()
    gov = TokenGovernor()
    bb.recover_expired_leases()
    tasks = bb.list_tasks()
    active_profile = detect_project_profile()

    try:
        from kernel.host import get_host_environment
        host_str = get_host_environment()["display_name"]
    except Exception:
        host_str = "Auto"

    print(f"\n=== Khoros v3.1 Status [{Path.cwd().name} | Profile: {active_profile} | Host: {host_str}] ===\n")
    if not tasks:
        print("No tasks registered in blackboard. Create one with: khoros task create <id> <title>")
    else:
        headers = ["ID", "Type", "Title", "Status", "Owner", "Deps", "Token"]
        rows = []
        for t in tasks:
            deps = bb.get_task_dependencies(t["id"])
            deps_str = ",".join(deps) if deps else "-"
            ttype = t.get("task_type", "feature")
            rows.append([t["id"], ttype, t["title"][:32], t["status"], t["owner"] or "-", deps_str, t["fencing_token"]])
        print(format_table(headers, rows))

    telemetry = gov.get_telemetry()
    print("\n--- Token Economy & Governor Telemetry ---")
    print(f"RPM: {telemetry['current_rpm']} / {telemetry['rpm_limit']} | TPM: {telemetry['current_tpm']} / {telemetry['tpm_limit']}")
    print(f"Cache Hit Rate: {telemetry['cache_hit_rate_percent']}% | Total Input: {telemetry['total_input_tokens']} | Cached: {telemetry['total_cached_tokens']}\n")


