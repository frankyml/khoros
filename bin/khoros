def cmd_lint(args):
    raw_targets = args.targets if args.targets else []
    targets = [Path(t) for t in raw_targets] if raw_targets else default_lint_targets()
    rc = run_lint_targets(targets)
    if rc != 0:
        sys.exit(rc)


def cmd_verify(args):
    raw_targets = args.targets if args.targets else []
    targets = [Path(t) for t in raw_targets] if raw_targets else None
    rc = run_verification_gate(targets=targets, profile=args.profile, run_tests=args.with_tests)
    if rc != 0:
        sys.exit(rc)


def cmd_profile(args):
    cfg_path = PROJECT_HARNESS_DIR / "config.yaml"
    if args.action == "show" or not args.name:
        prof = detect_project_profile()
        print(f"Active project profile: {prof} (Config: {cfg_path})")
        return

    new_prof = args.name.lower()
    if cfg_path.exists():
        text = cfg_path.read_text(encoding="utf-8")
        if re.search(r"^\s*profile:\s*", text, re.MULTILINE):
            text = re.sub(
                r"^(\s*profile:\s*).*$",
                rf'\g<1>"{new_prof}"',
                text,
                flags=re.MULTILINE,
            )
        else:
            text = f'profile: "{new_prof}"\n' + text
        cfg_path.write_text(text, encoding="utf-8")
    else:
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        cfg_path.write_text(f'# PDH v2.0 Config\nversion: "2.0"\nprofile: "{new_prof}"\n', encoding="utf-8")
    print(f"✓ Project profile updated to '{new_prof}' in {cfg_path}")


def cmd_monitor(args):
    bb = Blackboard()
    gov = TokenGovernor()
    bb.recover_expired_leases()
    tasks = bb.list_tasks()
    events = bb.list_events(limit=5)
    telemetry = gov.get_telemetry()
    active_profile = detect_project_profile()

    cols = shutil.get_terminal_size((80, 20)).columns
    print("\n" + "=" * cols)
    print(f" 🛸 PERSONAL DEVELOPMENT HARNESS (PDH v2.0) - LIVE MONITOR [{Path.cwd().name} | {active_profile}]".center(cols))
    print("=" * cols)
    print(f" Host: {platform.node()} ({platform.system()} {platform.release()}) | Arch: {platform.machine()}")
    print(f" Concurrency Limit: 2 subagents max | Active Workers: {sum(1 for t in tasks if t['status'] == 'CLAIMED')}")
    print("-" * cols)

    print("\n[ACTIVE & RECENT TASKS]")
    if not tasks:
        print("  No tasks registered.")
    else:
        headers = ["ID", "Type", "Title", "Status", "Owner", "Deps", "Token"]
        rows = []
        for t in tasks[-8:]:
            deps = bb.get_task_dependencies(t["id"])
            rows.append([
                t["id"],
                t.get("task_type", "feature"),
                t["title"][:28],
                t["status"],
                t["owner"] or "-",
                ",".join(deps) if deps else "-",
                t["fencing_token"],
            ])
        print(format_table(headers, rows))

    print("\n[TOKEN ECONOMY & GOVERNOR]")
    print(f"  RPM: {telemetry['current_rpm']}/{telemetry['rpm_limit']}  |  TPM: {telemetry['current_tpm']}/{telemetry['tpm_limit']}")
    print(f"  Cache Hit Rate: {telemetry['cache_hit_rate_percent']}%  |  Input: {telemetry['total_input_tokens']}  |  Cached: {telemetry['total_cached_tokens']}")

    print("\n[LATEST AUDIT EVENTS]")
    if not events:
        print("  No recent events.")
    else:
        for e in events:
            print(f"  Seq {e['seq']} [{e['severity']}]: {e['sender']} -> {e['recipient']} | {e['event_type']} ({e['trace_id']})")
    print("=" * cols + "\n")


def cmd_compact(args):
    bb = Blackboard()
    tasks = bb.list_tasks()
    completed = [t for t in tasks if t["status"] == "COMPLETED"]

    summary_path = Path("CURRENT_SPRINT_STATE.md")
    content = f"# Current Sprint State Checkpoint\nGenerated: {time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime())}\n\n"
    content += "## Completed Tasks\n"
    for t in completed:
        content += f"- **[{t['id']}]** ({t.get('task_type', 'feature')}) {t['title']} (Owner: {t['owner'] or 'orchestrator'})\n"

    pending = [t for t in tasks if t["status"] in ("PENDING", "CLAIMED", "REVIEW_REQUESTED")]
    content += "\n## Active / Pending Backlog\n"
    for t in pending:
        deps = bb.get_task_dependencies(t["id"])
        dep_note = f" | Depends on: {', '.join(deps)}" if deps else ""
        content += f"- **[{t['id']}]** ({t.get('task_type', 'feature')}) {t['title']} (Status: {t['status']}{dep_note})\n"

    with open(summary_path, "w", encoding="utf-8") as f:
        f.write(content)

    print(f"✓ Sprint state compacted to: {summary_path}")


def cmd_kaizen(args):
    bb = Blackboard()
    if args.kaizen_cmd == "list":
        props = bb.list_kaizen_proposals(status=args.status)
        if not props:
            print("No Kaizen proposals found.")
            return
        headers = ["Proposal ID", "Type", "Slug", "Risk Tier", "Status", "Canary FP"]
        rows = [
            [
                p["proposal_id"],
                p["target_type"],
                p["slug"],
                f"Tier {p['risk_tier']}",
                p["status"],
                str(p["canary_false_positives"]),
            ]
            for p in props
        ]
        print(format_table(headers, rows))
    elif args.kaizen_cmd == "inspect":
        props = [p for p in bb.list_kaizen_proposals() if p["proposal_id"] == args.proposal_id]
        if not props:
            print(f"Proposal '{args.proposal_id}' not found.")
            return
        p = props[0]
        print(f"=== Kaizen Proposal: {p['proposal_id']} [{p['slug']}] ===")
        print(f"Type: {p['target_type']} | Risk Tier: {p['risk_tier']} | Status: {p['status']}")
        print(f"Canary Scanned: {p['canary_scanned_files']} | False Positives: {p['canary_false_positives']}")
        print("\n--- Source Code ---")
        print(p["source_code"])
        print("\n--- Test Code ---")
        print(p["test_code"])
    elif args.kaizen_cmd == "approve":
        props = [p for p in bb.list_kaizen_proposals() if p["proposal_id"] == args.proposal_id]
        if not props:
            print(f"Proposal '{args.proposal_id}' not found.")
            return
        p = props[0]
        bb.update_kaizen_proposal_status(args.proposal_id, "APPROVED")
        target_path = Path.cwd() / ".harness" / "jigs" / f"{p['slug']}.py"
        target_path.parent.mkdir(parents=True, exist_ok=True)
        target_path.write_text(p["source_code"], encoding="utf-8")
        import hashlib
        bb.register_capability(
            capability_id=f"{p['target_type'].lower()}:{p['slug']}",
            cap_type=p["target_type"],
            file_path=str(target_path),
            content_hash=hashlib.sha256(p["source_code"].encode("utf-8")).hexdigest(),
            semantic_description=f"Kaizen approved {p['target_type']} for {p['slug']}",
            risk_tier=p["risk_tier"],
            status="ACTIVE",
        )
        print(f"✓ Proposal '{args.proposal_id}' APPROVED and deployed to {target_path}")
    elif args.kaizen_cmd == "reject":
        bb.update_kaizen_proposal_status(args.proposal_id, "REJECTED")
        print(f"✓ Proposal '{args.proposal_id}' REJECTED.")


def cmd_gc(args):
    bb = Blackboard()
    from kernel.gc import GenerationalGC
    gc = GenerationalGC(bb=bb)
    if getattr(args, "purge", False):
        count = gc.purge_archived(confirm=getattr(args, "confirm", False))
        print(f"✓ Permanently purged {count} archived capability artifacts.")
        return
    res = gc.run_macro_gc(dry_run=getattr(args, "dry_run", False))
    print(f"=== Khoros Generational GC [Dry-Run: {res['dry_run']}] ===")
    print(f"Soft-Deprecated ({len(res['soft_deprecated'])}): {', '.join(res['soft_deprecated']) or 'None'}")
    print(f"Cold-Archived   ({len(res['cold_archived'])}): {', '.join(res['cold_archived']) or 'None'}")
    print(f"Retained Active ({len(res['retained'])}): {', '.join(res['retained']) or 'None'}")


def cmd_restore(args):
    bb = Blackboard()
    from kernel.gc import GenerationalGC
    gc = GenerationalGC(bb=bb)
    ok, msg = gc.restore_capability(args.capability_id)
    print(msg)
    if not ok:
        sys.exit(1)


def cmd_skill(args):
    from skills.lifecycle import SkillLifecycleEngine
    eng = SkillLifecycleEngine()
    if args.skill_cmd == "mine":
        bb = Blackboard()
        task = bb.get_task(args.task_id)
        if not task:
            print(f"Task '{args.task_id}' not found.")
            sys.exit(1)
        events = [e for e in bb.list_events(limit=100) if e.get("trace_id") == args.task_id or args.task_id in str(e)]
        ok, msg, p = eng.mine_skill_from_task(
            task_id=args.task_id,
            slug=args.name or f"skill_{args.task_id.replace('-', '_')}",
            task_title=task["title"],
            events=events,
        )
        print(msg)
        print(f"Location: {p}")
    elif args.skill_cmd == "list":
        skills = list(eng.skills_dir.glob("*/SKILL.md"))
        if not skills:
            print("No skills found.")
            return
        print("=== Active Khoros Skills ===")
        for s in skills:
            print(f"- {s.parent.name} ({s})")


def bootstrap_workspace_harness(target_dir: Path = None, explicit_profile: str = None, quiet: bool = False) -> Path:
    target_dir = Path(target_dir) if target_dir else Path.cwd()
    target_harness = target_dir / ".harness"
    target_harness.mkdir(parents=True, exist_ok=True)

    # Btrfs no-CoW attribute; chattr only exists on Linux
    if shutil.which("chattr"):
        subprocess.run(["chattr", "+C", str(target_harness)], capture_output=True)

    # Copy project-specific config & token files if not already present
    detected_prof = explicit_profile or detect_project_profile(target_dir)
    for f in ["config.yaml", "design-tokens.json"]:
        src_f = ROOT_HARNESS_DIR / f
        dst_f = target_harness / f
        if src_f.exists() and not dst_f.exists():
            shutil.copy2(src_f, dst_f)
            if f == "config.yaml":
                text = dst_f.read_text(encoding="utf-8")
                text = re.sub(
                    r'^(\s*profile:\s*).*$',
                    rf'\g<1>"{detected_prof}"',
                    text,
                    flags=re.MULTILINE,
                )
                dst_f.write_text(text, encoding="utf-8")

    # Symlink engine python modules to canonical ROOT_HARNESS_DIR to prevent multi-project drift
    for py_mod in ["blackboard.py", "governor.py", "linter.py", "prd_engine.py", "dispatcher.py", "verifier.py"]:
        src_mod = ROOT_HARNESS_DIR / py_mod
        dst_mod = target_harness / py_mod
        if target_harness.resolve() != ROOT_HARNESS_DIR.resolve():
            if dst_mod.exists() or dst_mod.is_symlink():
                dst_mod.unlink()
            os.symlink(src_mod, dst_mod)

    # Copy personas and ast_index if missing; sync canonical roles so v2.0 role updates propagate
    for sub in ["personas", "ast_index"]:
        src_sub = ROOT_HARNESS_DIR / sub
        dst_sub = target_harness / sub
        if src_sub.exists() and not dst_sub.exists():
            shutil.copytree(src_sub, dst_sub)

    src_roles = ROOT_HARNESS_DIR / "roles"
    dst_roles = target_harness / "roles"
    if src_roles.exists() and target_harness.resolve() != ROOT_HARNESS_DIR.resolve():
        dst_roles.mkdir(parents=True, exist_ok=True)
        for rf in src_roles.glob("*.md"):
            shutil.copy2(rf, dst_roles / rf.name)

    if explicit_profile:
        cfg_path = target_harness / "config.yaml"
        if cfg_path.exists():
            text = cfg_path.read_text(encoding="utf-8")
            if re.search(r"^\s*profile:\s*", text, re.MULTILINE):
                text = re.sub(r"^(\s*profile:\s*).*$", rf'\g<1>"{explicit_profile.lower()}"', text, flags=re.MULTILINE)
            else:
                text = f'profile: "{explicit_profile.lower()}"\n' + text
            cfg_path.write_text(text, encoding="utf-8")

    bb = Blackboard(db_path=target_harness / "blackboard.db")
    if not quiet:
        print(f"✓ Harness v2.0 initialized and linked to canonical engine in: {target_dir} [Profile: {detect_project_profile(target_dir)}]")
        print(f"✓ SQLite WAL Blackboard ready at: {bb.db_path}")
    return target_harness


def ensure_workspace_harness() -> Path:
    global PROJECT_HARNESS_DIR
    cwd_harness = Path.cwd() / ".harness"
    if not cwd_harness.exists():
        bootstrap_workspace_harness(Path.cwd(), quiet=True)
    PROJECT_HARNESS_DIR = cwd_harness
    return cwd_harness


def cmd_init(args):
    bootstrap_workspace_harness(Path.cwd(), explicit_profile=getattr(args, "profile", None), quiet=False)


def main():
    parser = argparse.ArgumentParser(
        prog="khoros",
        description="Khoros (PDH v3.1) - Self-Improving Agentic Software Factory & Microkernel CLI",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # init
    init_p = subparsers.add_parser("init", help="Initialize harness in the current project directory")
    init_p.add_argument("--profile", help="Optional domain profile (generic, python, mobile-kmp, web, research)", default=None)

    # status
    subparsers.add_parser("status", help="Show current blackboard tasks, dependencies, and telemetry")

    # monitor
    subparsers.add_parser("monitor", help="Display rich live terminal system and token monitor")

    # triage
    triage_p = subparsers.add_parser("triage", help="Run Player-Coach Lead Orchestrator complexity triage on a request")
    triage_p.add_argument("request", help="User request or task description")
    triage_p.add_argument("--files", help="Comma-separated list of target files", default="")
    triage_p.add_argument("--type", choices=["feature", "bugfix", "refactor", "research", "qa", "ops"], default=None)

    # profile
    prof_p = subparsers.add_parser("profile", help="Show or set active domain profile")
    prof_p.add_argument("action", nargs="?", choices=["show", "set"], default="show")
    prof_p.add_argument("name", nargs="?", help="Profile name (generic, python, mobile-kmp, web, research)")

    # compact
    subparsers.add_parser("compact", help="Compact completed sprint tasks into CURRENT_SPRINT_STATE.md")

    # personas
    subparsers.add_parser("personas", help="List active project user personas and evaluation criteria")

    # task create
    task_parser = subparsers.add_parser("task", help="Task management")
    task_subs = task_parser.add_subparsers(dest="task_command", required=True)
    create_parser = task_subs.add_parser("create", help="Create a new task with optional DAG dependencies and contract")
    create_parser.add_argument("id", help="Unique task identifier")
    create_parser.add_argument("title", help="Human-readable title")
    create_parser.add_argument("--priority", choices=["Q0", "Q1", "Q2", "Q3"], default="Q2")
    create_parser.add_argument(
        "--type",
        choices=["feature", "bugfix", "refactor", "research", "qa", "ops", "spec"],
        default="feature",
        help="Task archetype",
    )
    create_parser.add_argument("--depends-on", dest="depends_on", default="", help="Comma-separated prerequisite task IDs")
    create_parser.add_argument("--files", default="", help="Comma-separated scope file paths")
    create_parser.add_argument("--criteria", default="", help="Semicolon-separated acceptance criteria")
    create_parser.add_argument("--spec", default=None, help="Path to specification document")

    # brief
    brief_p = subparsers.add_parser("brief", help="Generate a zero-loss Subagent Dispatch Packet from blackboard.db")
    brief_p.add_argument("task_id", nargs="?", help="Task ID")
    brief_p.add_argument("--task-id", dest="task_id_flag", help="Task ID")
    brief_p.add_argument("--role", default="@builder", help="Target specialist role (e.g., @builder, @explorer, @critic)")

    # claim
    claim_parser = subparsers.add_parser("claim", help="Directly claim a specific task")
    claim_parser.add_argument("task_id", nargs="?", help="Task ID to claim")
    claim_parser.add_argument("worker_pos", nargs="?", help="Optional worker name")
    claim_parser.add_argument("--task-id", dest="task_id_flag", help="Task ID to claim")
    claim_parser.add_argument("--worker", "--worker-id", dest="worker", help="Worker name")

    # heartbeat
    hb_parser = subparsers.add_parser("heartbeat", help="Extend lease on a claimed task")
    hb_parser.add_argument("task_id", nargs="?", help="Task ID")
    hb_parser.add_argument("--task-id", dest="task_id_flag", help="Task ID")
    hb_parser.add_argument("--token", type=int, default=None, help="Optional fencing token")

    # submit / complete / worker-complete
    for sub_name in ("submit", "complete", "worker-complete"):
        sub_p = subparsers.add_parser(sub_name, help="Submit a task for review after passing verification checks")
        sub_p.add_argument("task_id", nargs="?", help="Task ID to submit")
        sub_p.add_argument("--task-id", dest="task_id_flag", help="Task ID to submit")
        sub_p.add_argument("--token", type=int, default=None, help="Optional fencing token")
        sub_p.add_argument("--summary", default="Implementation completed and verified", help="Completion summary")
        sub_p.add_argument("--skip-lint", action="store_true", help="Skip pre-submit verification gate")

    # review
    review_parser = subparsers.add_parser("review", help="Review a submitted task and its contract")
    review_parser.add_argument("task_id", nargs="?", help="Task ID to inspect")
    review_parser.add_argument("--task-id", dest="task_id_flag", help="Task ID to inspect")
    review_parser.add_argument("--token", type=int, default=None, help="Optional fencing token (ignored)")

    # approve / review-approve
    for app_name in ("approve", "review-approve"):
        approve_parser = subparsers.add_parser(app_name, help="Approve and finalize a task")
        approve_parser.add_argument("task_id", nargs="?", help="Task ID to approve")
        approve_parser.add_argument("--task-id", dest="task_id_flag", help="Task ID to approve")
        approve_parser.add_argument("--token", type=int, default=None, help="Optional fencing token (ignored)")
        approve_parser.add_argument("--skip-lint", action="store_true", help="Skip verification gate")

    # reject
    reject_parser = subparsers.add_parser("reject", help="Reject a task with feedback")
    reject_parser.add_argument("task_id", nargs="?", help="Task ID to reject")
    reject_parser.add_argument("--task-id", dest="task_id_flag", help="Task ID to reject")
    reject_parser.add_argument("--feedback", help="Feedback message for the agent", default="")

    # recover
    subparsers.add_parser("recover", help="Scrub locks and recover expired leases")

    # events
    events_parser = subparsers.add_parser("events", help="Show event log")
    events_parser.add_argument("--limit", type=int, default=20, help="Number of events to display")

    # prd
    prd_parser = subparsers.add_parser("prd", help="Generate a formal PRD with Mermaid diagrams")
    prd_parser.add_argument("slug", help="Slug for the document filename")
    prd_parser.add_argument("title", help="Human-readable feature title")
    prd_parser.add_argument("--problem", default="Provide a reliable, high-craft solution.", help="Problem statement")
    prd_parser.add_argument("--profile", default=None, help="Optional profile override")

    # spec (multi-archetype)
    spec_parser = subparsers.add_parser("spec", help="Generate a domain-agnostic specification (prd, rfc, rca, brief)")
    spec_parser.add_argument("spec_type", choices=["prd", "rfc", "rca", "brief"], help="Specification archetype")
    spec_parser.add_argument("slug", help="Slug for the document filename")
    spec_parser.add_argument("title", help="Human-readable title")
    spec_parser.add_argument("--problem", default="Define clear problem boundaries, architecture, and verification criteria.", help="Problem statement")
    spec_parser.add_argument("--profile", default=None, help="Optional profile override")

    # lint
    lint_parser = subparsers.add_parser("lint", help="Lint UI source code against design tokens")
    lint_parser.add_argument("targets", nargs="*", help="Files or directories to lint")

    # verify
    verify_parser = subparsers.add_parser("verify", help="Run universal multi-profile verification gate")
    verify_parser.add_argument("targets", nargs="*", help="Optional files or directories to verify")
    verify_parser.add_argument("--profile", default=None, help="Override project profile")
    verify_parser.add_argument("--with-tests", action="store_true", help="Also execute automated unit test suite")

    # dispatch
    dispatch_parser = subparsers.add_parser("dispatch", help="Dispatch pending tasks (respecting DAG barriers & concurrency cap)")
    dispatch_parser.add_argument("task_id", nargs="?", default=None, help="Optional specific task ID to dispatch")
    dispatch_parser.add_argument("--worker", "--worker-id", dest="worker", help="Optional explicit worker name", default=None)

    # kaizen
    kaizen_parser = subparsers.add_parser("kaizen", help="Manage Kaizen proposals, distillation, and capability hygiene")
    kaizen_sub = kaizen_parser.add_subparsers(dest="kaizen_cmd", required=True)

    k_list = kaizen_sub.add_parser("list", help="List proposals")
    k_list.add_argument("--status", default=None, help="Filter by status (QUARANTINED, APPROVED, REJECTED, AUTO_ADMITTED)")

    k_inspect = kaizen_sub.add_parser("inspect", help="Inspect a proposal")
    k_inspect.add_argument("proposal_id", help="Proposal ID")

    k_approve = kaizen_sub.add_parser("approve", help="Approve a proposal and deploy capability")
    k_approve.add_argument("proposal_id", help="Proposal ID to approve")

    k_reject = kaizen_sub.add_parser("reject", help="Reject a proposal")
    k_reject.add_argument("proposal_id", help="Proposal ID to reject")
    k_reject.add_argument("--reason", default="", help="Optional rejection reason")

    # gc
    gc_parser = subparsers.add_parser("gc", help="Run generational garbage collection and capability hygiene")
    gc_parser.add_argument("--dry-run", action="store_true", help="Simulate GC without mutating capability status")
    gc_parser.add_argument("--purge", action="store_true", help="Permanently delete archived capability artifacts")
    gc_parser.add_argument("--confirm", action="store_true", help="Required confirmation flag for purge")

    # restore
    restore_parser = subparsers.add_parser("restore", help="Restore an archived capability back to active status")
    restore_parser.add_argument("capability_id", help="Capability ID to restore")

    # skill
    skill_parser = subparsers.add_parser("skill", help="Manage procedural skill playbooks and trajectory mining")
    skill_sub = skill_parser.add_subparsers(dest="skill_cmd", required=True)

    s_mine = skill_sub.add_parser("mine", help="Mine procedural skill playbook from a completed task")
    s_mine.add_argument("task_id", help="Task ID to mine")
    s_mine.add_argument("--name", default=None, help="Optional slug name for the mined skill")

    s_list = skill_sub.add_parser("list", help="List active procedural skills")

    # host
    subparsers.add_parser("host", help="Inspect host OS, architecture, memory, CoW filesystem, and agent runtime")

    args = parser.parse_args()

    if args.command in ("task", "spec", "prd") or (args.command == "profile" and args.action == "set"):
        ensure_workspace_harness()

    if args.command == "init":
        cmd_init(args)
    elif args.command == "host":
        cmd_host(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "monitor":
        cmd_monitor(args)
    elif args.command == "triage":
        cmd_triage(args)
    elif args.command == "profile":
        cmd_profile(args)
    elif args.command == "compact":
        cmd_compact(args)
    elif args.command == "personas":
        cmd_personas(args)
    elif args.command == "task" and args.task_command == "create":
        cmd_task_create(args)
    elif args.command == "brief":
        cmd_brief(args)
    elif args.command == "claim":
        cmd_claim(args)
    elif args.command == "heartbeat":
        cmd_heartbeat(args)
    elif args.command in ("submit", "complete", "worker-complete"):
        cmd_submit(args)
    elif args.command == "review":
        cmd_review(args)
    elif args.command in ("approve", "review-approve"):
        cmd_approve(args)
    elif args.command == "reject":
        cmd_reject(args)
    elif args.command == "recover":
        cmd_recover(args)
    elif args.command == "events":
        cmd_events(args)
    elif args.command == "prd":
        cmd_prd(args)
    elif args.command == "spec":
        cmd_spec(args)
    elif args.command == "lint":
        cmd_lint(args)
    elif args.command == "verify":
        cmd_verify(args)
    elif args.command == "kaizen":
        cmd_kaizen(args)
    elif args.command == "gc":
        cmd_gc(args)
    elif args.command == "restore":
        cmd_restore(args)
    elif args.command == "skill":
        cmd_skill(args)
    elif args.command == "dispatch":
        dispatcher = TaskDispatcher()
        ok, msg = dispatcher.dispatch_next(worker_name=args.worker, task_id=args.task_id)
        print(msg)
        if not ok:
            sys.exit(1)


if __name__ == "__main__":
    main()
