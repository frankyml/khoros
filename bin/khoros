def cmd_triage(args):
    router = LeadRouter()
    files = [f.strip() for f in args.files.split(",") if f.strip()] if args.files else []
    res = router.triage(args.request, scope_files=files, explicit_type=args.type)
    print(f"\n=== Lead Orchestrator (@lead) Triage Assessment ===")
    print(f"  Complexity Tier      : {res['tier']}")
    print(f"  Task Archetype       : {res['task_type']}")
    print(f"  Execution Mode       : {res['execution_mode']}")
    print(f"  Recommended Spec     : {res['recommended_spec']}")
    print(f"  Specialist Topology  : {', '.join(res['recommended_roles'])}")
    print(f"  Workspace Isolation  : {res['workspace_isolation']} (Max Workers: {res['max_parallel_workers']})")
    print(f"  Rationale            : {res['rationale']}\n")


def cmd_task_create(args):
    bb = Blackboard()
    gov = TokenGovernor()
    deps = [d.strip() for d in args.depends_on.split(",") if d.strip()] if getattr(args, "depends_on", None) else []
    files = [f.strip() for f in args.files.split(",") if f.strip()] if getattr(args, "files", None) else []
    criteria = [c.strip() for c in args.criteria.split(";") if c.strip()] if getattr(args, "criteria", None) else []

    payload = {
        "priority": args.priority,
        "task_type": args.type,
        "depends_on": deps,
        "scope_files": files,
        "acceptance_criteria": criteria,
    }
    if getattr(args, "spec", None):
        payload["spec_path"] = args.spec

    bb.create_task(args.id, args.title, payload=payload, task_type=args.type, depends_on=deps)
    gov.record_usage(PriorityTier.Q1_REASONING, input_tokens=18000, cached_tokens=16384, output_tokens=1024)
    dep_msg = f" (depends_on: {', '.join(deps)})" if deps else ""
    print(f"Task '{args.id}' [{args.type}] successfully created in blackboard{dep_msg}.")


def cmd_brief(args):
    dispatcher = TaskDispatcher()
    tid = _resolve_task_id(args)
    packet = dispatcher.generate_subagent_packet(tid, role=args.role)
    print(packet)


def cmd_claim(args):
    bb = Blackboard()
    tid = _resolve_task_id(args)
    met, unmet = bb.are_dependencies_met(tid)
    if not met:
        print(
            f"Error: Cannot claim '{tid}' — unmet DAG dependencies: {', '.join(unmet)}.",
            file=sys.stderr,
        )
        sys.exit(1)

    worker = args.worker or args.worker_pos or f"worker-{tid}"
    ok, token = bb.claim_task(tid, worker)
    if ok:
        print(f"Claimed '{tid}' for '{worker}' (Fencing Token: {token})")
    else:
        print(f"Failed to claim '{tid}' (already claimed or does not exist).", file=sys.stderr)
        sys.exit(1)


def cmd_heartbeat(args):
    bb = Blackboard()
    tid = _resolve_task_id(args)
    if bb.heartbeat(tid, args.token):
        print(f"Heartbeat recorded for '{tid}'. Lease extended.")
    else:
        print(f"Failed to heartbeat '{tid}' (not in CLAIMED state or token mismatch).", file=sys.stderr)
        sys.exit(1)


def cmd_submit(args):
    bb = Blackboard()
    gov = TokenGovernor()
    tid = _resolve_task_id(args)
    tasks = {t["id"]: t for t in bb.list_tasks()}
    if tid not in tasks:
        print(f"Error: Task '{tid}' not found.", file=sys.stderr)
        sys.exit(1)

    if not getattr(args, "skip_lint", False):
        rc = run_verification_gate()
        if rc != 0:
            print(f"Error: Cannot submit '{tid}' while verification violations exist.", file=sys.stderr)
            sys.exit(1)

    summary = getattr(args, "summary", None) or "Implementation completed and verified"
    ok = bb.complete_task(tid, fencing_token=args.token, result={"summary": summary})
    if ok:
        gov.record_usage(PriorityTier.Q2_CODING, input_tokens=36000, cached_tokens=32768, output_tokens=2048)
        print(f"Task '{tid}' submitted for review (status: REVIEW_REQUESTED).")
    else:
        print(f"Error: Could not transition '{tid}' to REVIEW_REQUESTED.", file=sys.stderr)
        sys.exit(1)


def cmd_review(args):
    bb = Blackboard()
    tid = _resolve_task_id(args)
    contract = bb.get_task_contract(tid)
    if not contract:
        print(f"Error: Task '{tid}' not found.", file=sys.stderr)
        sys.exit(1)

    print(f"\n--- Reviewing Task: {contract['id']} ({contract['title']}) ---")
    print(
        f"Status: {contract['status']} | Type: {contract['task_type']} | "
        f"Owner: {contract['owner']} | Fencing Token: {contract['fencing_token']}"
    )
    print("Contract:", json.dumps(contract, indent=2))


def cmd_approve(args):
    bb = Blackboard()
    gov = TokenGovernor()
    tid = _resolve_task_id(args)
    tasks = {t["id"]: t for t in bb.list_tasks()}
    if tid not in tasks:
        print(f"Error: Task '{tid}' not found.", file=sys.stderr)
        sys.exit(1)

    if not getattr(args, "skip_lint", False):
        rc = run_verification_gate()
        if rc != 0:
            print(f"Error: Approval blocked for '{tid}' due to verification violations.", file=sys.stderr)
            sys.exit(1)

    with bb._get_connection() as conn:
        conn.execute(
            "UPDATE tasks SET status = 'COMPLETED', updated_at = ? WHERE id = ?;",
            (time.time(), tid),
        )
    gov.record_usage(PriorityTier.Q0_CRITICAL, input_tokens=24000, cached_tokens=22000, output_tokens=1024)
    bb.publish_event(
        trace_id=tid,
        sender="reviewer_gate",
        recipient="orchestrator",
        event_type="TASK_APPROVED",
        severity="INFO",
        payload={"approved_by": "reviewer_gate"},
    )
    print(f"Task '{tid}' APPROVED and marked COMPLETED.")


def cmd_reject(args):
    bb = Blackboard()
    tid = _resolve_task_id(args)
    tasks = {t["id"]: t for t in bb.list_tasks()}
    if tid not in tasks:
        print(f"Error: Task '{tid}' not found.", file=sys.stderr)
        sys.exit(1)

    with bb._get_connection() as conn:
        conn.execute(
            "UPDATE tasks SET status = 'PENDING', owner = NULL, updated_at = ? WHERE id = ?;",
            (time.time(), tid),
        )
    bb.publish_event(
        trace_id=tid,
        sender="reviewer_gate",
        recipient="orchestrator",
        event_type="TASK_REJECTED",
        severity="WARN",
        payload={"feedback": args.feedback or "No feedback provided."},
    )
    print(f"Task '{tid}' REJECTED and returned to PENDING with feedback.")


def cmd_recover(args):
    bb = Blackboard()
    reclaimed = bb.recover_expired_leases()
    print(f"Recovery complete. Reclaimed {reclaimed} expired/abandoned task lease(s).")


def cmd_events(args):
    bb = Blackboard()
    events = bb.list_events(limit=args.limit)
    print(f"\n=== Recent Events (Latest {len(events)}) ===\n")
    if not events:
        print("No events logged yet.")
    else:
        headers = ["Seq", "Timestamp", "Trace ID", "Sender", "Type", "Severity"]
        rows = [
            [e["seq"], e["timestamp"][:19], e["trace_id"], e["sender"], e["event_type"], e["severity"]]
            for e in events
        ]
        print(format_table(headers, rows))
    print()


def cmd_personas(args):
    personas_dir = PROJECT_HARNESS_DIR / "personas"
    print(f"\n=== Active Project Personas ({personas_dir}) ===\n")
    if not personas_dir.exists():
        print("No personas directory found.")
        return
    files = sorted(personas_dir.glob("*.json"))
    if not files:
        print("No persona JSON files found.")
        return
    for pf in files:
        try:
            data = json.loads(pf.read_text(encoding="utf-8"))
            print(f"• {data.get('name', pf.stem)} — {data.get('archetype', '')}")
            for p in data.get("priorities", []):
                print(f"    + Priority: {p}")
            for ft in data.get("frictionTriggers", []):
                print(f"    - Reject Trigger: {ft}")
            print()
        except Exception as e:
            print(f"• {pf.name}: Error reading ({e})")


